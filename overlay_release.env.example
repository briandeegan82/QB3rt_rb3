# GitHub Release that holds the slim bootstrap overlay (share/+lib/ for custom
# packages). NOT committed to git — too large (~0.5 GB compressed).
#
# Build locally:  ./pack_overlay.sh --tarball
# Upload:         gh release create overlay-YYYY-MM-DD qb3rt-overlay.tar.gz
# Then set:
OVERLAY_REPO=briandeegan82/QB3rt_rb3
OVERLAY_RELEASE_TAG=
OVERLAY_ASSET=qb3rt-overlay.tar.gz
