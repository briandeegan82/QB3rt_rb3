#!/bin/bash
# Managed by ansible role https_time_sync — edit ansible/roles/https_time_sync
# and re-run the playbook rather than hand-editing this file on the device.
set -euo pipefail

# HTTPS endpoints whose response Date header is used as the time source.
URLS=(
{% for url in https_time_sync_urls %}
    "{{ url }}"
{% endfor %}
)

# Reject a source more than this many seconds from our current clock. Boards
# with no RTC battery can come up arbitrarily stale (observed: 50+ days) since
# they boot to a fixed build-time default rather than drifting from a real
# clock, so there's no bounded window that's both "wide enough to bootstrap
# any unit" and "tight enough to catch a bad source" -- --bootstrap instead
# skips this check entirely. That's safe specifically in bootstrap mode
# because the whole premise of running it is "the local clock is known
# garbage," so comparing a candidate time against it can't actually detect a
# bad *source* -- the URLS list (fixed, trusted, well-known sites) is what
# guards against that, not this diff.
MAX_DIFF_SECONDS="${MAX_DIFF_SECONDS:-{{ https_time_sync_max_diff_seconds }}}"
BOOTSTRAP=0
[[ "${1:-}" == "--bootstrap" ]] && BOOTSTRAP=1

log() {
    logger -t https-time-sync "$*"
    echo "$*"
}

for url in "${URLS[@]}"; do
    # Fetch only headers. --max-time prevents a dead server hanging the service.
    # --insecure: a unit with no RTC can boot with the clock far enough in the
    # past that the *current* live cert on these sites isn't valid yet from
    # its point of view ("certificate is not yet valid") -- exactly the
    # skew this script exists to fix, so we can't require a valid chain to
    # read the Date header. Safe here because nothing from the response body
    # is trusted or executed, only a header, and outside --bootstrap the
    # resulting time is still sanity-checked against MAX_DIFF_SECONDS below.
    # `|| true` on the assignment: under `set -e`+pipefail a curl failure
    # (bad cert, timeout, DNS, refused) would otherwise abort the whole
    # script on the first bad URL instead of falling through to the next one.
    date_header="$(
        curl --silent --show-error --insecure \
             --head \
             --max-time 10 \
             --connect-timeout 5 \
             "$url" 2>/dev/null |
        awk 'BEGIN{IGNORECASE=1} /^Date:/ {$1=""; sub(/^[ \t]+/, ""); print; exit}'
    )" || true

    if [[ -z "$date_header" ]]; then
        log "No Date header received from $url"
        continue
    fi

    # Convert RFC 7231 HTTP date to Unix epoch.
    epoch="$(date -u -d "$date_header" +%s 2>/dev/null)" || {
        log "Could not parse Date header from $url: $date_header"
        continue
    }

    now="$(date +%s)"
    difference=$(( epoch - now ))
    (( difference < 0 )) && difference=$(( -difference ))

    if (( BOOTSTRAP == 0 )) && (( difference > MAX_DIFF_SECONDS )); then
        log "Rejecting $url: time differs by ${difference}s (max ${MAX_DIFF_SECONDS}s)"
        continue
    fi

    log "Setting clock from $url: $date_header"

    # Set the kernel clock.
    date -u -s "@$epoch"

    # Keep the hardware clock updated if an RTC exists.
    hwclock --systohc 2>/dev/null || true

    log "Clock successfully synchronized"
    exit 0
done

log "ERROR: No HTTPS time source was usable"
exit 1
